# Native eight-workload runtime image for bounded distributed functional experiments.
#
# The base already contains LEGOSim, SimBricks BaseIf transport, and the
# distributed runtime overlay. The four single-stage sources are copied into
# stable in-image paths and compiled with the same GPGPU-Sim CUDA toolchain.
ARG BASE_IMAGE=chipsystemsim:native-base-functional-metrics-v1
FROM ${BASE_IMAGE}

COPY ../single_stage_simulator/benchmark/FFT /opt/legosim/benchmark/fft
COPY ../single_stage_simulator/benchmark/Pagerank /opt/legosim/benchmark/pagerank
COPY ../single_stage_simulator/benchmark/PDE /opt/legosim/benchmark/pde
COPY ../single_stage_simulator/benchmark/MoE /opt/legosim/benchmark/moe

RUN /bin/bash -lc 'set -euo pipefail; \
    export SIMULATOR_ROOT=/opt/legosim; \
    export CUDA_INSTALL_PATH=${CUDA_INSTALL_PATH:-/usr}; \
    set +u; \
    source /opt/legosim/gpgpu-sim/setup_environment; \
    set -u; \
    for benchmark in fft pagerank pde moe; do \
      make -C "/opt/legosim/benchmark/${benchmark}" NVCC="nvcc -ccbin /usr/bin/g++-10" -j"$(nproc)"; \
    done'
