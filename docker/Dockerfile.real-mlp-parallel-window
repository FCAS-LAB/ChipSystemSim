# Native MLP with an opt-in restoration of its upstream independent GPU-task
# scheduling. Serial scheduling remains the default runtime behavior.
ARG BASE_IMAGE=chipsystemsim:native-mlp-compute-window-v1
FROM ${BASE_IMAGE}

USER root
COPY real/patch_mlp_parallel_gpu_tasks.py /opt/chipsystemsim-distributed/

RUN /bin/bash -lc 'set -euo pipefail; \
    export SIMULATOR_ROOT=/opt/legosim CUDA_INSTALL_PATH=${CUDA_INSTALL_PATH:-/usr}; \
    set +u; source /opt/legosim/gpgpu-sim/setup_environment; set -u; \
    python3 /opt/chipsystemsim-distributed/patch_mlp_parallel_gpu_tasks.py; \
    make -C /opt/legosim/artifact/MLP clean_all; \
    make -C /opt/legosim/artifact/MLP NVCC="nvcc -ccbin /usr/bin/g++-10"'
