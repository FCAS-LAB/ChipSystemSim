# Diagnostic-only image.  It layers GDB on the validated native LEGOSim image
# so an upstream CUDA process can produce a backtrace without changing the
# workload binary or its runtime environment.
FROM chipsystemsim:8166851-simbricks-pthread-fixed

USER root
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends gdb \
    && rm -rf /var/lib/apt/lists/*
