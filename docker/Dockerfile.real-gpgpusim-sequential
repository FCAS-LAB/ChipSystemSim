# Repair the GPGPU-Sim stream-manager race exposed by native MLP phase1-0.
ARG BASE_IMAGE=chipsystemsim:native-eight-functional-prewarm-v1
FROM ${BASE_IMAGE}

USER root
RUN python3 - <<'PY'
from pathlib import Path
source = Path('/opt/legosim/gpgpu-sim/src/gpgpusim_entrypoint.cc')
text = source.read_text(encoding='utf-8')
old = '''    if (api == 1) {
      pthread_create(&(the_gpgpusim->g_simulation_thread), NULL,
                     gpgpu_sim_thread_concurrent, (void *)this);
    } else {
      pthread_create(&(the_gpgpusim->g_simulation_thread), NULL,
                     gpgpu_sim_thread_sequential, (void *)this);
    }'''
new = '''    // The concurrent CUDA API thread races stream_manager::empty_protected
    // against host-side kernel submission for this LEGOSim MLP binary.
    // Use the upstream sequential simulation worker for deterministic stream
    // ownership; independent LEGOSim phases remain separate OS processes.
    (void)api;
    pthread_create(&(the_gpgpusim->g_simulation_thread), NULL,
                   gpgpu_sim_thread_sequential, (void *)this);'''
if old not in text:
    raise SystemExit('expected GPGPU-Sim thread-selection block not found')
source.write_text(text.replace(old, new), encoding='utf-8')
PY
RUN /bin/bash -lc 'set -euo pipefail; export CUDA_INSTALL_PATH=${CUDA_INSTALL_PATH:-/usr}; set +u; source /opt/legosim/gpgpu-sim/setup_environment; set -u; cd /opt/legosim/gpgpu-sim; make -j"$(nproc)"'
