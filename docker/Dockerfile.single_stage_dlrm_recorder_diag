# Rebuild only Sniper's Pin recorder after adding PipeComm progress markers.
ARG BASE_IMAGE=chipsystemsim:single-stage-dlrm_cpp_large-gdb-router-fixed
FROM ${BASE_IMAGE}

COPY ChipSystemSim/real/patch_sniper_recorder_diagnostics.py \
     ChipSystemSim/real/worker.py /opt/chipsystemsim-distributed/

RUN bash -lc 'python3 /opt/chipsystemsim-distributed/patch_sniper_recorder_diagnostics.py && \
    make -C /opt/legosim/snipersim/sift/recorder \
      PIN_ROOT=/opt/legosim/snipersim/pin_kit -j"$(nproc)"'
