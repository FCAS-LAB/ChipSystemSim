# Diagnostic-only layer for capturing native simulator crashes.
ARG BASE_IMAGE=chipsystemsim:native-eight-functional-prewarm-v1
FROM ${BASE_IMAGE}

USER root
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends gdb \
    && rm -rf /var/lib/apt/lists/*
