# Fast runtime-only layer for distributed-adapter iterations.
#
# The parent image is the fully built native LEGOSim toolchain. Keeping this
# layer separate means a change to a Python proxy does not re-download Pin or
# rebuild GPGPU-Sim. Release images must still be produced with Dockerfile.real.
ARG BASE_IMAGE=legosim-real:8166851
FROM ${BASE_IMAGE}

# MNSIM is an upstream LEGOSIM component. Pin its Python runtime here rather
# than allowing its workload launcher to install packages during each run.
RUN python3 -m pip install --no-cache-dir \
        numpy==1.26.4 \
        pandas==2.2.2 \
    && python3 -m pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        torch==2.3.1 \
        torchvision==0.18.1

# MNSIM's checked-in Python driver retains this legacy absolute task path.
# Keep its source intact and expose the same LEGOSim task assets there.
RUN mkdir -p /home/qc/Chiplet_Heterogeneous_newVersion_gem5/Chiplet_Heterogeneous_newVersion \
    && ln -s /opt/legosim/tasks-vgg13 \
        /home/qc/Chiplet_Heterogeneous_newVersion_gem5/Chiplet_Heterogeneous_newVersion/tasks-vgg13 \
    && ln -s /usr/bin/python3 /usr/local/bin/python

COPY real/entrypoint.sh /usr/local/bin/legosim-run
COPY real/fifo_broker.py real/worker.py real/process_proxy.py /opt/legosim-distributed/
RUN chmod +x /usr/local/bin/legosim-run

ENTRYPOINT ["/usr/local/bin/legosim-run"]
