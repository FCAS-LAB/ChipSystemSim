ARG BASE_IMAGE=chipsystemsim:single-stage-dlrm_cpp_large-worker-fixed
FROM ${BASE_IMAGE}

COPY ChipSystemSim/real/patch_sniper_pthread_diagnostics.py /opt/chipsystemsim-distributed/

RUN bash -lc 'python3 /opt/chipsystemsim-distributed/patch_sniper_pthread_diagnostics.py && \
    make -C /opt/legosim/snipersim/sift/recorder \
      PIN_ROOT=/opt/legosim/snipersim/pin_kit -j"$(nproc)"'
