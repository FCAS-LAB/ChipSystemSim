 void* bridge_thread(void* __args_ptr) {
     ProcessStruct* proc_struct = (ProcessStruct*)__args_ptr;
+    auto trace_bridge = [&](const std::string& message) {
+        std::ofstream trace_file("bridge-trace.log", std::ios::app);
+        trace_file << "thread=" << proc_struct->m_thread << " phase=" << proc_struct->m_phase
